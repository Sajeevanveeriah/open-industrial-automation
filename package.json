{
  "name": "open-industrial-automation",
  "version": "2.3.0",
  "description": "Potato processing plant digital twin simulation for independent Dooen engineering review.",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "test": "npm run verify:source && npm run build && npm run test:delivery && npm run test:simulation && npm run test:workshop",
    "test:simulation": "node --test tests/potato-engine.test.mjs tests/potato-systems.test.mjs",
    "test:simulation-ui": "node scripts/potato-ui.mjs",
    "dev": "vite",
    "test:delivery": "node --test tests/potato-delivery.test.mjs",
    "test:migration": "node scripts/potato-migration.mjs",
    "test:workshop": "node --test tests/workshop-*.test.mjs",
    "test:workshop-ui": "node scripts/workshop-ui.mjs && node scripts/workshop-cad-ui.mjs"
  },
  "devDependencies": {
    "axe-core": "4.12.1",
    "playwright": "1.62.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "occt-import-js": "0.0.23",
    "sql.js": "1.15.2",
    "three": "0.185.1"
  }
}
