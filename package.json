{
  "name": "open-industrial-automation",
  "version": "2.2.1",
  "description": "Potato processing plant digital twin simulation for independent Dooen engineering review.",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "test": "npm run verify:source && npm run build && npm run test:delivery && npm run test:simulation",
    "test:simulation": "node --test tests/potato-engine.test.mjs",
    "test:simulation-ui": "node scripts/potato-ui.mjs",
    "dev": "vite",
    "test:delivery": "node --test tests/potato-delivery.test.mjs",
    "test:migration": "node scripts/potato-migration.mjs"
  },
  "devDependencies": {
    "axe-core": "4.12.1",
    "playwright": "1.62.0",
    "vite": "^8.2.2"
  }
}
