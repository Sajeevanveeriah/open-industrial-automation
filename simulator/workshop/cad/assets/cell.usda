#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)
def Cube "belt"
{
    double size = 1
    double3 xformOp:translate = (1, 0, 0.45)
    double3 xformOp:scale = (2, 0.5, 0.1)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}
def Cube "carton"
{
    double size = 1
    double3 xformOp:translate = (0.4, 0, 0.6)
    double3 xformOp:scale = (0.3, 0.2, 0.2)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}
def Cube "robot"
{
    double size = 1
    double3 xformOp:translate = (1.2, 0.5, 0.4)
    double3 xformOp:scale = (0.2, 0.2, 0.8)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}
