<?xml version="1.0"?>
<robot name="oia_training_arm">
  <link name="base"><visual><geometry><cylinder radius="0.09" length="0.08"/></geometry></visual><collision><geometry><cylinder radius="0.09" length="0.08"/></geometry></collision></link>
  <link name="upper"><visual><origin xyz="0.3 0 0"/><geometry><box size="0.6 0.05 0.05"/></geometry></visual><collision><origin xyz="0.3 0 0"/><geometry><box size="0.6 0.05 0.05"/></geometry></collision><inertial><origin xyz="0.3 0 0"/><mass value="2"/><inertia ixx="0.0008333" ixy="0" ixz="0" iyy="0.0604167" iyz="0" izz="0.0604167"/></inertial></link>
  <link name="fore"><visual><origin xyz="0.2 0 0"/><geometry><box size="0.4 0.05 0.05"/></geometry></visual><collision><origin xyz="0.2 0 0"/><geometry><box size="0.4 0.05 0.05"/></geometry></collision><inertial><origin xyz="0.2 0 0"/><mass value="1"/><inertia ixx="0.0004167" ixy="0" ixz="0" iyy="0.0135417" iyz="0" izz="0.0135417"/></inertial></link>
  <link name="tool"><visual><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.04 0.04"/></geometry></visual><collision><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.04 0.04"/></geometry></collision></link>
  <link name="tcp"/>
  <joint name="shoulder" type="revolute"><origin xyz="0 0 0.08"/><parent link="base"/><child link="upper"/><axis xyz="0 0 1"/><limit lower="-3.14159" upper="3.14159" effort="12" velocity="1.4"/></joint>
  <joint name="elbow" type="revolute"><origin xyz="0.6 0 0"/><parent link="upper"/><child link="fore"/><axis xyz="0 0 1"/><limit lower="-2.96706" upper="2.96706" effort="12" velocity="1.4"/></joint>
  <joint name="tool_mount" type="fixed"><origin xyz="0.4 0 0"/><parent link="fore"/><child link="tool"/></joint>
  <joint name="tool_tip" type="fixed"><origin xyz="0.08 0 0"/><parent link="tool"/><child link="tcp"/></joint>
</robot>
